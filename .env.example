PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local). Never commit the real value.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/TaspefDB

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5174

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Used only by `npm run seed:admin`
SEED_ADMIN_NAME=TASPEF Admin
SEED_ADMIN_EMAIL=admin@taspef.org
SEED_ADMIN_PASSWORD=change-this-before-running
